# development / test / production
NODE_ENV=development
HOST=127.0.0.1
PORT=3010
DATABASE_URL=postgresql://user:password@localhost:5432/xiaochuang?schema=public
REDIS_URL=redis://127.0.0.1:6379
CORS_ORIGINS=http://localhost:3001,http://localhost:3002
SESSION_COOKIE_NAME=xiaochuang_session
SESSION_DURATION_DAYS=7
AI_CONFIG_ENCRYPTION_KEY=YOUR_AI_CONFIG_ENCRYPTION_KEY_AT_LEAST_16_CHARS
# development/test 可用 console；production 禁止 console，需接入真实短信网关
SMS_PROVIDER=console
# Vidu 等第三方回调时使用的后端公网地址（必须可被外部访问）
WEBHOOK_BASE_URL=https://your-public-backend.example.com
VIDU_WEBHOOK_SECRET=YOUR_VIDU_WEBHOOK_SECRET_AT_LEAST_16_CHARS

# 本地开发验证码（development 生效；生产环境自动忽略）
DEV_AUTH_PHONE=13800138000
DEV_AUTH_CODE=123456

# local / s3
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=../data/static
# local 开发可用 backend /static；生产环境启动时要求 STORAGE_DRIVER=s3 且使用远程公开地址
STORAGE_PUBLIC_BASE_URL=http://127.0.0.1:3010/static
# 远程媒体下载域名白名单，逗号分隔；留空时仍会拦截 localhost/内网/链路本地/保留地址
STORAGE_REMOTE_URL_ALLOWLIST=

# S3-compatible storage settings（当 STORAGE_DRIVER=s3 时必填）
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# MinIO 本地开发示例（推荐作为 V2.0 对象存储主链路验证口径）
# 先执行：npm run runtime:up（同时启动 PostgreSQL / Redis / MinIO）
# 或仅执行：bash tools/start-minio-dev.sh（只启动 MinIO）
# STORAGE_DRIVER=s3
# STORAGE_PUBLIC_BASE_URL=http://127.0.0.1:9000/xiaochuang-media
# S3_ENDPOINT=http://127.0.0.1:9000
# S3_REGION=us-east-1
# S3_BUCKET=xiaochuang-media
# S3_ACCESS_KEY_ID=minioadmin
# S3_SECRET_ACCESS_KEY=minioadmin123

# ===== 火山方舟（Volcengine Ark）模型 =====
# 文档：https://www.volcengine.com/docs/82379/?lang=zh
# 在本地 .env 中填入真实值后，运行 `npm run volc:setup`（apps/backend）
# 即可把以下模型写入当前用户的 AI 服务配置（默认 AI_SETUP_USER_ID=1）。请勿提交真实密钥。
AI_SETUP_USER_ID=1
VOLC_ARK_API_KEY=
VOLC_ARK_BASE_URL=https://ark.cn-beijing.volces.com
# 文本模型（接入点 ID，例如 ep-xxxxxxxx）
VOLC_TEXT_MODEL_PRO=
VOLC_TEXT_MODEL_DEEPSEEK=
VOLC_TEXT_MODEL_MINI=
# 视频模型（接入点 ID）
VOLC_VIDEO_MODEL_SEEDANCE=

# ===== 其他 P0 厂商（本地测试，勿提交密钥）=====
# 运行 npm run ai:setup-local 写入当前用户配置（见 AI_SETUP_USER_ID）
MOONSHOT_API_KEY=
MOONSHOT_TEXT_MODEL=moonshot-v1-8k
DEEPSEEK_API_KEY=
DEEPSEEK_TEXT_MODEL=deepseek-v4-flash
MINIMAX_TEXT_MODEL=abab6.5s-chat
ALI_API_KEY=
ALI_TEXT_MODEL=qwen-plus
# 快手可灵（JWT：Access Key + Secret Key，无 Key 时可只对接不测试）
KLING_ACCESS_KEY=
KLING_SECRET_KEY=
KLING_VIDEO_MODEL=kling-v2-6

# ===== 短剧 AI-first（默认开启，正式生成必须走 AI 任务运行时或真实文本 AI 配置）=====
DRAMA_AI_FIRST_ENABLED=1
# 仅限内部联调/测试。开启后才允许使用本地规则种子打通链路；生产环境禁止开启。
DRAMA_AI_FIRST_LOCAL_RULE_FALLBACK=0
# 设置为 remote/text/ai_runtime 后启用 RemoteDramaAgentAdapter；设为 disabled 可显式禁止旧直连模型路径，
# 便于仅验证本地规则回退或将五步任务全部交由 AI 任务运行时。
# 不单独配置 BASE_URL/API_KEY/MODEL 时，会复用当前激活的文本 AI 配置。
DRAMA_AGENT_PROVIDER=
DRAMA_AGENT_BASE_URL=
DRAMA_AGENT_API_KEY=
DRAMA_AGENT_MODEL=

# ===== AI 任务运行时（默认关闭；不直接向运行时暴露用户 API Key 或数据库）=====
# 需部署参考项目中的 xiaochuang-drama 本地工具桥：每个 Run 的能力令牌仅存于 Hermes ContextVar，
# 工具调用时通过本 Backend 的 Streamable HTTP MCP 入口转发，绝不能写入 prompt 或工具参数。
AGENT_RUNTIME_PROVIDER=disabled
AGENT_RUNTIME_HERMES_API_KEY=
# Hermes 到 Backend MCP 工具入口的固定服务身份。它不是用户 Provider Key。
AGENT_RUNTIME_MCP_SERVICE_KEY=
# Hermes 到 Backend Model Gateway 的固定服务身份。它不是用户 Provider Key。
AGENT_RUNTIME_MODEL_GATEWAY_SERVICE_KEY=
# Hermes 容器/进程实际可访问的 Backend API 根地址；必须包含全局 /api/v1 前缀，
# 不可填写 Web 前端端口。例如：https://xiaochuang-backend.internal/api/v1。
HERMES_RUNTIME_BACKEND_BASE_URL=
# JSON 示例：
# 每个池都必须绑定通用运行政策与当前阶段 Skill；两个 sha256 均为对应 SKILL.md 的精确 UTF-8 内容摘要。
# {"pools":[{"name":"drama-source-pool","toolProfile":"xiaochuang-drama-source","skillBundle":"drama-source@1.0.0","skillManifest":[{"ref":"xiaochuang_runtime_policy@1.0.0","sha256":"运行政策SKILL.md的64位小写SHA256"},{"ref":"drama_source_understanding@1.0.0","sha256":"源稿理解SKILL.md的64位小写SHA256"}],"allowedTools":["get_task_context","list_source_chunks","get_source_chunk","submit_source_chunk_analysis","submit_source_analysis","report_progress","complete_execution","fail_execution"],"modelProfile":"xiaochuang-text-project","maxConcurrentRuns":10,"maxConcurrentRunsPerUser":2,"instances":[{"name":"hermes-source-1","baseUrl":"http://127.0.0.1:8642"}]},{"name":"drama-plan-pool","toolProfile":"xiaochuang-drama-plan","skillBundle":"drama-plan@1.0.0","skillManifest":[{"ref":"xiaochuang_runtime_policy@1.0.0","sha256":"运行政策SKILL.md的64位小写SHA256"},{"ref":"drama_episode_planning@1.0.0","sha256":"分集规划SKILL.md的64位小写SHA256"}],"allowedTools":["get_task_context","list_source_chunks","get_source_chunk","submit_blueprint_batch","report_progress","complete_execution","fail_execution"],"modelProfile":"xiaochuang-text-project","maxConcurrentRuns":10,"maxConcurrentRunsPerUser":2,"instances":[{"name":"hermes-plan-1","baseUrl":"http://127.0.0.1:8643"}]},{"name":"drama-script-pool","toolProfile":"xiaochuang-drama-script","skillBundle":"drama-script@1.0.0","skillManifest":[{"ref":"xiaochuang_runtime_policy@1.0.0","sha256":"运行政策SKILL.md的64位小写SHA256"},{"ref":"drama_episode_script_writing@1.0.0","sha256":"剧本正文SKILL.md的64位小写SHA256"}],"allowedTools":["get_task_context","list_source_chunks","get_source_chunk","submit_episode_script","report_progress","complete_execution","fail_execution"],"modelProfile":"xiaochuang-text-project","maxConcurrentRuns":10,"maxConcurrentRunsPerUser":2,"instances":[{"name":"hermes-script-1","baseUrl":"http://127.0.0.1:8644"}]}]}
# 故事地图池追加对象：
# {"name":"drama-graph-pool","toolProfile":"xiaochuang-drama-graph","skillBundle":"drama-graph@1.0.0","skillManifest":[{"ref":"xiaochuang_runtime_policy@1.0.0","sha256":"运行政策SKILL.md的64位小写SHA256"},{"ref":"drama_story_graph_build@1.0.0","sha256":"故事地图SKILL.md的64位小写SHA256"}],"allowedTools":["get_task_context","list_episode_scripts","get_episode_script","submit_story_graph_batch","report_progress","complete_execution","fail_execution"],"modelProfile":"xiaochuang-text-project","maxConcurrentRuns":10,"maxConcurrentRunsPerUser":2,"instances":[{"name":"hermes-graph-1","baseUrl":"http://127.0.0.1:8645"}]}
# 单集分镜池追加对象：
# {"name":"drama-storyboard-pool","toolProfile":"xiaochuang-drama-storyboard","skillBundle":"drama-storyboard@1.0.0","skillManifest":[{"ref":"xiaochuang_runtime_policy@1.0.0","sha256":"运行政策SKILL.md的64位小写SHA256"},{"ref":"drama_storyboard_planning@1.0.0","sha256":"单集分镜SKILL.md的64位小写SHA256"}],"allowedTools":["get_storyboard_task_context","list_episode_script_segments","get_episode_script_segment","get_storyboard_assets","submit_storyboard_batch","report_progress","complete_execution","fail_execution"],"modelProfile":"xiaochuang-text-project","maxConcurrentRuns":10,"maxConcurrentRunsPerUser":2,"instances":[{"name":"hermes-storyboard-1","baseUrl":"http://127.0.0.1:8646"}]}
HERMES_RUNTIME_POOLS_JSON=
# 代表已启用并验证每次 Run 的能力令牌桥接；未部署 bridge 时必须保持 0。
HERMES_RUNTIME_PER_RUN_MCP_AUTH_ENABLED=0
# 仅在 Hermes 已将每次 Run capability ContextVar 注入模型 Gateway 请求头并验证后启用。
HERMES_RUNTIME_PER_RUN_MODEL_GATEWAY_AUTH_ENABLED=0
HERMES_RUNTIME_MCP_CAPABILITY_HEADER=X-Xiaochuang-MCP-Capability
# Ed25519 PEM。私钥只在小创控制面；公钥部署到 xiaochuang-drama MCP。
AGENT_RUNTIME_CAPABILITY_PRIVATE_KEY=
AGENT_RUNTIME_CAPABILITY_PUBLIC_KEY=
# capability 是短期服务凭证；Hermes 会在临近过期时以旧 capability、固定服务身份
# 和 execution id 调用 Backend 内部续期接口。续期保持相同 scope 与 jti，仅刷新 iat/exp。
# 它不是 max_tokens、集数、批量或任务运行时长上限。
AGENT_RUNTIME_CAPABILITY_TTL_SECONDS=900
# 这是失联运行槽的心跳租约，不是 Agent 或模型的总运行时长限制。
AGENT_RUNTIME_LEASE_TTL_SECONDS=900
# Compose 中 task-recover 的恢复扫描周期和每轮扫描数；它不参与模型推理。
TASK_RECOVER_INTERVAL_MS=15000
TASK_RECOVER_LIMIT=20

# ===== Mock AI（仅专项调试，默认不要开启）=====
# mock 代码保留用于专项联调，但默认链路已切换到真实服务。
# 如需把 mock 配置重新写入数据库，必须显式授权：
#   ALLOW_MOCK_AI_SETUP=1 npm run mock:ai:setup --workspace apps/backend
# 或：
#   npm run mock:ai:setup --workspace apps/backend -- --allow-mock-setup
ALLOW_MOCK_AI_SETUP=0
