# Keep AGENT_RUNTIME_PROVIDER=disabled until the deployment gates described in
# docs/0.24.0/技术设计-HermesAgent运行时集成方案.md are verified.
AGENT_RUNTIME_PROVIDER=disabled

# Generate separate deployment secrets. These are service identities only;
# never place a user's model Provider API key in this file.
AGENT_RUNTIME_HERMES_API_KEY=
AGENT_RUNTIME_MCP_SERVICE_KEY=
AGENT_RUNTIME_MODEL_GATEWAY_SERVICE_KEY=

# The Backend sees Hermes through the internal-only agent-runtime network.
# This is the Backend API root, including Nest's global /api/v1 prefix.
HERMES_RUNTIME_BACKEND_BASE_URL=http://backend:3010/api/v1
HERMES_RUNTIME_PER_RUN_MCP_AUTH_ENABLED=1
HERMES_RUNTIME_PER_RUN_MODEL_GATEWAY_AUTH_ENABLED=1
HERMES_RUNTIME_MCP_CAPABILITY_HEADER=X-Xiaochuang-MCP-Capability
AGENT_RUNTIME_CAPABILITY_PRIVATE_KEY=
AGENT_RUNTIME_CAPABILITY_PUBLIC_KEY=
# Renew an active execution shortly before its capability expires. This is
# credential maintenance only, not a cap on Agent turns, batches, output, or
# elapsed task time.
XIAOCHUANG_CAPABILITY_REFRESH_SKEW_SECONDS=60
# Optional transport timeout for a single renewal HTTP request. Leave empty
# unless deployment networking requires one; it is not a task timeout.
XIAOCHUANG_CAPABILITY_REFRESH_TIMEOUT_SECONDS=

# JSON value for the Backend. Start from deploy/hermes/pools.example.json, then
# compact it into one line, for example:
# HERMES_RUNTIME_POOLS_JSON="$(node -e "process.stdout.write(JSON.stringify(require('./deploy/hermes/pools.example.json')))")"
# Recalculate and review the SHA-256 values whenever a released SKILL.md changes.
HERMES_RUNTIME_POOLS_JSON=
