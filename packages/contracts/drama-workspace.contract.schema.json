{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xiaochuang.local/contracts/drama-workspace/2026-07-13.v1",
  "title": "Drama workspace Contract v1",
  "type": "object",
  "$defs": {
    "reviewStatus": {
      "type": "string",
      "enum": ["pending_confirmation", "confirmed", "rework_required", "stale", "archived"]
    },
    "reviewSubjectType": {
      "type": "string",
      "enum": ["episode_script", "storyboard_set", "episode_final"]
    },
    "reviewCheckpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["subject_type", "subject_id", "episode_id", "episode_number", "label", "href", "version_key", "review_status", "reviewed_at", "review_note"],
      "properties": {
        "subject_type": { "$ref": "#/$defs/reviewSubjectType" },
        "subject_id": { "type": "string", "minLength": 1 },
        "episode_id": { "type": "integer", "minimum": 1 },
        "episode_number": { "type": "integer", "minimum": 1 },
        "label": { "type": "string", "minLength": 1 },
        "href": { "type": "string", "pattern": "^/drama/" },
        "version_key": { "type": "string", "minLength": 1 },
        "review_status": { "$ref": "#/$defs/reviewStatus" },
        "reviewed_at": { "type": ["string", "null"], "format": "date-time" },
        "review_note": { "type": ["string", "null"] }
      }
    },
    "reviewSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract_version", "primary_action", "review"],
      "properties": {
        "contract_version": { "const": "2026-07-13.v1" },
        "primary_action": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "title", "description", "href", "subject_type", "subject_id"],
          "properties": {
            "kind": { "type": "string", "enum": ["confirm_script", "confirm_storyboard", "confirm_final", "review_project", "create_reviewable_output"] },
            "title": { "type": "string", "minLength": 1 },
            "description": { "type": "string", "minLength": 1 },
            "href": { "type": "string", "pattern": "^/drama/" },
            "subject_type": { "anyOf": [{ "$ref": "#/$defs/reviewSubjectType" }, { "type": "null" }] },
            "subject_id": { "type": ["string", "null"] }
          }
        },
        "review": {
          "type": "object",
          "additionalProperties": false,
          "required": ["total", "confirmed", "needs_attention", "deliverable", "items"],
          "properties": {
            "total": { "type": "integer", "minimum": 0 },
            "confirmed": { "type": "integer", "minimum": 0 },
            "needs_attention": { "type": "integer", "minimum": 0 },
            "deliverable": { "type": "boolean" },
            "items": { "type": "array", "maxItems": 20, "items": { "$ref": "#/$defs/reviewCheckpoint" } }
          }
        }
      }
    },
    "confirmReviewRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["subject_type", "subject_id", "version_key"],
      "properties": {
        "subject_type": { "$ref": "#/$defs/reviewSubjectType" },
        "subject_id": { "type": "string", "minLength": 1 },
        "version_key": { "type": "string", "minLength": 1 },
        "note": { "type": "string", "maxLength": 2000 }
      }
    },
    "requireReworkRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["subject_type", "subject_id", "reason_code"],
      "properties": {
        "subject_type": { "$ref": "#/$defs/reviewSubjectType" },
        "subject_id": { "type": "string", "minLength": 1 },
        "reason_code": { "type": "string", "minLength": 1, "maxLength": 80 },
        "note": { "type": "string", "maxLength": 2000 }
      }
    }
  }
}
